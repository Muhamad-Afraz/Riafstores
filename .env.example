# Shared product database (required on serverless hosts such as Vercel).
# Any Postgres provider works: Neon, Supabase, Vercel Postgres, Railway, etc.
# Example: postgresql://user:password@host/db?sslmode=require
DATABASE_URL=

# Set to "true" only if your Postgres does not support SSL (local Docker, etc).
# PGSSL_DISABLE=false

# Admin panel credentials. Use a long random value for the secret.
# Signing in requires the password plus a 6-digit code emailed to ADMIN_EMAIL
# (uses the same RESEND_API_KEY / SMTP settings as account sign-in).
# Quote values that contain "#" or spaces.
ADMIN_EMAIL=admin@riaf.co
ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=generate-a-long-random-string
# Recovery only: set to true to skip the emailed admin code. Keep unset normally.
# ADMIN_OTP_DISABLED=false

# Website account sign-in. Use long random values for both secrets.
AUTH_SESSION_SECRET=generate-a-long-random-string
# Optional: separate pepper for hashing sign-in codes. Defaults to AUTH_SESSION_SECRET.
# AUTH_OTP_SECRET=

# Email delivery for sign-in codes. Configure one of the two options below.
# Option 1: Resend (https://resend.com). AUTH_EMAIL_FROM must use a verified domain
# in production. Without any email configuration, development shows the code on screen.
RESEND_API_KEY=
AUTH_EMAIL_FROM=RIAF <onboarding@resend.dev>

# Option 2: SMTP (for example Gmail with an app password, or your own mail server).
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

# Google sign-in. Create an OAuth 2.0 Client ID (Web application) in Google Cloud
# and add <your-site>/api/account/google/callback as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional override. Defaults to <request origin>/api/account/google/callback.
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/account/google/callback
